nativelibs/zjxl/.deps-prefix/
nativelibs/zjxl/deps-src/

# zimage libvips deps (built from pinned source into a content-addressed cache)
nativelibs/zimage/.deps-prefix/
nativelibs/zimage/deps-src/

# mp4thumb FFmpeg deps (built from pinned source into a content-addressed cache)
nativelibs/mp4thumb/.deps-prefix/
nativelibs/mp4thumb/deps-src/

# Scratch / installer / logs
temp/
*.dmg
*.log

# Editor / local
.claude/
.DS_Store

